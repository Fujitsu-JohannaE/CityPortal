@using CityPortal.Models
@model SubmissionDetailViewModel
@{
    ViewData["Title"] = "Asiakirjan tiedot";
    var sub        = Model.Submission;
    var tenantSlug = ViewBag.TenantSlug as string;

    // Check if submission has lat/lon coordinates from a map field
    var mapFields = Model.Fields.Where(f => f.FieldType == FieldTypes.Map).ToList();
    string? mapLat = null;
    string? mapLon = null;
    string? mapAddress = null;
    foreach (var mf in mapFields)
    {
        sub.FormData.TryGetValue(mf.FieldKey + "_lat", out var lat);
        sub.FormData.TryGetValue(mf.FieldKey + "_lon", out var lon);
        if (!string.IsNullOrEmpty(lat) && !string.IsNullOrEmpty(lon))
        {
            mapLat = lat;
            mapLon = lon;
            // Get the address from the target field
            var addressKey = mf.ConditionalOnField;
            if (addressKey != null)
                sub.FormData.TryGetValue(addressKey, out mapAddress);
            break;
        }
    }
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/@tenantSlug/admin">Postilaatikko</a></li>
        <li class="breadcrumb-item active">@sub.Id.ToString()[..8].ToUpper()</li>
    </ol>
</nav>

<div class="row">

    @* ── Left: submitted data ────────────────────────────────────────────────── *@
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom d-flex
                         justify-content-between align-items-center py-3">
                <div>
                    <h5 class="mb-0">@sub.FormTitle</h5>
                    <small class="text-muted">
                        Lähetetty @sub.SubmittedAt.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
                @{
                    var (badgeClass, icon) = sub.Status switch
                    {
                        "Uusi"        => ("bg-danger",  "bi-dot"),
                        "Käsittelyssä" => ("bg-warning text-dark", "bi-arrow-repeat"),
                        "Ratkaistu"   => ("bg-success", "bi-check"),
                        "Hylätty"     => ("bg-dark",    "bi-x"),
                        _            => ("bg-secondary","bi-question")
                    };
                }
                <span class="badge @badgeClass fs-6">
                    <i class="bi @icon me-1"></i>@sub.Status
                </span>
            </div>

            <div class="card-body">
                @* Identity row *@
                <div class="alert @(sub.IsAnonymous ? "alert-secondary" : "alert-info") py-2 mb-4">
                    @if (sub.IsAnonymous)
                    {
                        <i class="bi bi-incognito me-2"></i>
                        <strong>Nimetön lähetys</strong>
                        @if (!string.IsNullOrEmpty(sub.AnonymousEmail))
                        {
                            <span class="ms-2 text-muted">Yhteystieto: @sub.AnonymousEmail</span>
                        }
                    }
                    else
                    {
                        <i class="bi bi-person-check me-2"></i>
                        <strong>Suomi.fi verified:</strong> @sub.SuomiFiName
                        <span class="ms-2 badge bg-light text-muted border font-monospace">
                            hetu: @(sub.SuomiFiHetu != null ? "●●●●●●●●●●●" : "ei talletettu")
                        </span>
                    }
                </div>

                @* ── The key part: render FormData JSON using field definitions ── *@
                @* Field labels come from FormFields table, values from JSON column *@
                <dl class="row">
                    @foreach (var (label, value) in Model.GetDisplayRows())
                    {
                        <dt class="col-sm-4 text-muted fw-normal small">@label</dt>
                        <dd class="col-sm-8">
                            @if (value == "true")
                            {
                                <i class="bi bi-check-square-fill text-success"></i>
                                <span class="text-success ms-1">Kyllä</span>
                            }
                            else if (value == "false" || value == "—")
                            {
                                <span class="text-muted">@value</span>
                            }
                            else
                            {
                                @value
                            }
                        </dd>
                    }
                </dl>

                @* ── Location map (read-only, shown when lat/lon exist) ── *@
                @if (mapLat != null && mapLon != null)
                {
                    <hr />
                    <h6 class="text-muted small text-uppercase mb-2">
                        <i class="bi bi-geo-alt-fill me-1"></i>Sijainti kartalla
                    </h6>
                    <div id="admin-map" class="rounded mb-2" style="height: 300px; z-index: 0;"
                         data-lat="@mapLat" data-lon="@mapLon"
                         data-address="@(mapAddress ?? "")">
                    </div>
                    <div class="small text-muted mb-2">
                        <i class="bi bi-crosshair me-1"></i>
                        Koordinaatit: @mapLat, @mapLon
                    </div>
                }

                @* Attachments *@
                @if (sub.Attachments.Any())
                {
                    <hr />
                    <h6 class="text-muted small text-uppercase mb-2">
                        <i class="bi bi-paperclip me-1"></i>Liitteet (@sub.Attachments.Count kpl)
                    </h6>

                    @* ── Image previews grid ── *@
                    var imageAttachments = sub.Attachments
                        .Where(a => a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    var otherAttachments = sub.Attachments
                        .Where(a => !a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    @if (imageAttachments.Any())
                    {
                        <div class="row g-2 mb-3">
                            @foreach (var att in imageAttachments)
                            {
                                var isMalicious = att.MalwareScanResult == "Malicious";
                                var isPending = att.MalwareScanResult == "Pending";
                                var isClean = att.MalwareScanResult == "Clean";
                                var imgUrl = $"/{tenantSlug}/admin/submission/{sub.Id}/attachment/{att.FileName}";

                                <div class="col-6 col-md-4">
                                    <div class="card border @(isMalicious ? "border-danger" : "border-0") shadow-sm h-100">
                                        @if (isMalicious)
                                        {
                                            <div class="card-img-top bg-danger bg-opacity-10 d-flex align-items-center justify-content-center"
                                                 style="height:140px">
                                                <div class="text-center text-danger">
                                                    <i class="bi bi-shield-exclamation fs-1"></i>
                                                    <div class="small mt-1">Estetty</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <a href="#" data-bs-toggle="modal" data-bs-target="#lightboxModal"
                                               onclick="document.getElementById('lightboxImg').src='@imgUrl';document.getElementById('lightboxTitle').textContent='@att.FileName';">
                                                <img src="@imgUrl"
                                                     alt="@att.FileName"
                                                     class="card-img-top"
                                                     style="height:140px; object-fit:cover; cursor:zoom-in;" />
                                            </a>
                                        }
                                        <div class="card-body p-2">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="small text-truncate" title="@att.FileName"
                                                      style="max-width:120px">@att.FileName</span>
                                                <div class="d-flex gap-1">
                                                    @if (isClean)
                                                    {
                                                        <span class="badge bg-success" title="Puhdas">
                                                            <i class="bi bi-shield-check"></i>
                                                        </span>
                                                    }
                                                    else if (isMalicious)
                                                    {
                                                        <span class="badge bg-danger" title="Haittaohjelma">
                                                            <i class="bi bi-shield-exclamation"></i>
                                                        </span>
                                                    }
                                                    else if (isPending)
                                                    {
                                                        <span class="badge bg-warning text-dark" title="Tarkistus käynnissä">
                                                            <i class="bi bi-hourglass-split"></i>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="text-muted" style="font-size:0.7rem">
                                                @(att.FileSizeBytes / 1024) KB
                                            </div>
                                            <div class="mt-1 d-flex gap-1">
                                                @if (!isMalicious)
                                                {
                                                    <a href="@imgUrl" download="@att.FileName"
                                                       class="btn btn-sm btn-outline-primary py-0 px-1" title="Lataa">
                                                        <i class="bi bi-download" style="font-size:0.75rem"></i>
                                                    </a>
                                                }
                                                @if (isPending)
                                                {
                                                    <form method="post"
                                                          action="/@tenantSlug/admin/submission/@sub.Id/attachment/@att.FileName/scan"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                                title="Päivitä tarkistuksen tila">
                                                            <i class="bi bi-arrow-clockwise" style="font-size:0.75rem"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* ── Non-image attachments (PDF etc.) ── *@
                    @foreach (var att in otherAttachments)
                    {
                        var isMalicious = att.MalwareScanResult == "Malicious";
                        var isPending = att.MalwareScanResult == "Pending";
                        var isClean = att.MalwareScanResult == "Clean";

                        <div class="d-flex align-items-center p-2 bg-light rounded mb-2 @(isMalicious ? "border border-danger" : "")">
                            <i class="bi bi-file-earmark me-2 text-muted"></i>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="small fw-semibold">@att.FileName</span>
                                    @if (isClean)
                                    {
                                        <span class="badge bg-success" title="Puhdas">
                                            <i class="bi bi-shield-check me-1"></i>Puhdas
                                        </span>
                                    }
                                    else if (isMalicious)
                                    {
                                        <span class="badge bg-danger" title="Haittaohjelma">
                                            <i class="bi bi-shield-exclamation me-1"></i>Haittaohjelma
                                        </span>
                                    }
                                    else if (isPending)
                                    {
                                        <span class="badge bg-warning text-dark" title="Tarkistus käynnissä">
                                            <i class="bi bi-hourglass-split me-1"></i>Tarkistus käynnissä
                                        </span>
                                    }
                                </div>
                                <div class="text-muted" style="font-size:0.75rem">
                                    @att.ContentType — @(att.FileSizeBytes / 1024) KB
                                </div>
                            </div>
                            <div class="ms-2 d-flex gap-1">
                                @if (!isMalicious)
                                {
                                    <a href="/@tenantSlug/admin/submission/@sub.Id/attachment/@att.FileName"
                                       class="btn btn-sm btn-outline-primary" title="Lataa">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }
                                @if (isPending)
                                {
                                    <form method="post"
                                          action="/@tenantSlug/admin/submission/@sub.Id/attachment/@att.FileName/scan"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                title="Päivitä tarkistuksen tila">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }

                @* Raw JSON — shows the actual stored data *@
                <hr />
                <details class="mt-3">
                    <summary class="text-muted small cursor-pointer">
                        <i class="bi bi-code-slash me-1"></i>
                        View raw FormData JSON (stored in database column)
                    </summary>
                    <pre class="bg-dark text-success rounded p-3 mt-2 small">@System.Text.Json.JsonSerializer.Serialize(
    sub.FormData,
    new System.Text.Json.JsonSerializerOptions { WriteIndented = true }
)</pre>
                </details>
            </div>
        </div>
    </div>

    @* ── Right: case management ──────────────────────────────────────────────── *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0">
                    <i class="bi bi-pencil-square me-2"></i>Tapausten hallinta
                </h6>
            </div>
            <div class="card-body">
                <form method="post"
                      action="/@tenantSlug/admin/submission/@sub.Id/status">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tila</label>
                        <select name="status" class="form-select form-select-sm">
                            @foreach (var s in new[]{"Uusi","Käsittelyssä","Ratkaistu","Hylätty"})
                            {
                                <option value="@s"
                                        selected="@(sub.Status == s)">@s</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Vastuuhenkilö</label>
                        <input type="text" name="assignedTo" class="form-control form-control-sm"
                               value="@sub.AssignedTo" placeholder="Tiimi tai henkilön nimi" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sisäiset muistiinpanot</label>
                        <textarea name="internalNotes" class="form-control form-control-sm"
                                  rows="4"
                                  placeholder="Muistiinpanot näkyvät vain viranomaisille...">@sub.InternalNotes</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-save me-1"></i>Tallenna
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-0 bg-light mt-3">
            <div class="card-body small text-muted">
                <div class="mb-2">
                    <strong>Viite:</strong>
                    <span class="font-monospace">@sub.Id.ToString()[..8].ToUpper()</span>
                </div>
                <div class="mb-2">
                    <strong>Lomake:</strong> @sub.FormSlug
                </div>
                <div>
                    <strong>Kenttien nimet</strong> tulevat
                    <code>FormFields</code>-taulusta.<br />
                    <strong>Arvot</strong> tulevat
                    <code>FormData</code>-JSON-sarakkeesta.
                </div>
            </div>
        </div>
    </div>

</div>

@* ── Lightbox modal for full-size image preview ── *@
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 bg-transparent shadow-none">
            <div class="modal-header border-0 bg-dark bg-opacity-75 text-white py-2">
                <span id="lightboxTitle" class="small"></span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 text-center bg-dark bg-opacity-75">
                <img id="lightboxImg" src="" alt="Preview"
                     class="img-fluid" style="max-height:80vh; object-fit:contain;" />
            </div>
        </div>
    </div>
</div>

@if (mapLat != null && mapLon != null)
{
    @section Styles {
        <link rel="stylesheet" href="/lib/leaflet/leaflet.css" />
        <link rel="stylesheet" href="/lib/leaflet/leaflet.fullscreen.css" />
    }

    @section Scripts {
        <script src="/lib/leaflet/leaflet.js"></script>
        <script src="/lib/leaflet/leaflet.fullscreen.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const el = document.getElementById('admin-map');
                if (!el) return;

                const lat = parseFloat(el.dataset.lat);
                const lon = parseFloat(el.dataset.lon);
                const address = el.dataset.address;

                if (isNaN(lat) || isNaN(lon)) return;

                const map = L.map('admin-map', {
                    scrollWheelZoom: false,
                    fullscreenControl: {
                        position: 'topleft',
                        title: {
                            'false': 'Koko näyttö',
                            'true': 'Poistu koko näytöstä'
                        }
                    }
                }).setView([lat, lon], 16);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                    maxZoom: 19
                }).addTo(map);

                const marker = L.marker([lat, lon]).addTo(map);
                if (address) {
                    marker.bindPopup(`<strong>${address}</strong>`).openPopup();
                }
            });
        </script>
    }
}
