<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Kaupunkiportaali</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">
                <i class="bi bi-building me-2"></i>Kaupunkiportaali
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    @{
                        var slug = ViewBag.TenantSlug as string ?? "vantaa";
                        var isLoggedIn = Context.Session.GetString("SuomiFiName") != null;
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/@slug/forms">
                            <i class="bi bi-list-ul me-1"></i>Lomakkeet
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/@slug/admin">
                            <i class="bi bi-inbox me-1"></i>Tapaukset
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-building me-1"></i>Kaupunki
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/vantaa/forms">
                                    <i class="bi bi-geo me-1"></i>Vantaa
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/espoo/forms">
                                    <i class="bi bi-geo me-1"></i>Espoo
                                </a>
                            </li>
                        </ul>
                    </li>
                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-warning">
                                <i class="bi bi-person-check me-1"></i>
                                @Context.Session.GetString("SuomiFiName")
                            </span>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="/@slug/auth/logout" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-light my-1 ms-2">
                                    Kirjaudu ulos
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        @RenderBody()
    </div>

    <footer class="bg-light border-top mt-5 py-3">
        <div class="container text-muted small text-center">
            Kaupunkiportaali — Multitenant lomake- ja tapaushallintajärjestelmä demo
            <br />
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/conditional-fields.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>