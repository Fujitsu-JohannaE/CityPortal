@using CityPortal.Models
@model List<FormDefinition>
@{
    ViewData["Title"] = "Available Forms";
    var tenantSlug = ViewBag.TenantSlug as string;
}

<div class="row mb-4">
    <div class="col">
        <h1 class="h3">
            <i class="bi bi-files me-2 text-primary"></i>
            @ViewBag.TenantName — Palvelupyyntölomakkeet
        </h1>
        <p class="text-muted">Valitse lomake lähettääksesi palvelupyynnön kaupungille.</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var form in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3">
                        <div class="form-icon me-3">
                            @switch (form.Slug)
                            {
                                case "pothole-report":
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-2"></i>
                                    break;
                                case "tree-trimming":
                                    <i class="bi bi-tree-fill text-success fs-2"></i>
                                    break;
                                case "noise-complaint":
                                    <i class="bi bi-volume-up-fill text-danger fs-2"></i>
                                    break;
                                default:
                                    <i class="bi bi-file-earmark-text-fill text-primary fs-2"></i>
                                    break;
                            }
                        </div>
                        <div>
                            <h5 class="card-title mb-1">@form.Title</h5>
                            @if (form.RequireSuomiFi)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-shield-lock me-1"></i>Suomi.Fi tunnistautuminen vaaditaan
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-person me-1"></i>Ei edellytä kirjatumista
                                </span>
                            }
                        </div>
                    </div>
                    <p class="card-text text-muted small">@form.Description</p>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="/@tenantSlug/forms/@form.Slug" class="btn btn-primary w-100">
                        <i class="bi bi-pencil-square me-2"></i>Avaa lomake
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<div class="row mt-5">
    <div class="col">
        <div class="card bg-light border-0">
            <div class="card-body py-2 px-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Nyt näytetään kaupungin <strong>@ViewBag.TenantName</strong> lomakkeita.
                    Vaihda kaupunkia:
                    <a href="/vantaa/forms">Vantaa</a> |
                    <a href="/espoo/forms">Espoo</a>
                </small>
            </div>
        </div>
    </div>
</div>