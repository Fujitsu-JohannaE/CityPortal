@model CityPortal.Models.FormSubmission
@{
    ViewData["Title"] = "Pyyntö lähetetty";
    var tenantSlug = ViewBag.TenantSlug as string;
    var tenantName = ViewBag.TenantName as string;
    var redirectSeconds = 8;
}

<div class="row justify-content-center">
    <div class="col-md-7 text-center py-5">

        @* ── Success alert ─────────────────────────────────────────────────── *@
        <div class="alert alert-success shadow-sm border-0 py-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill" style="font-size:3rem"></i>
            <h2 class="h4 mt-3 mb-2">Pyyntö lähetetty onnistuneesti!</h2>
            <p class="mb-0">
                Lomakkeesi <strong>@Model?.FormTitle</strong> on vastaanotettu
                ja se käsitellään kaupungin viranomaisten toimesta.
            </p>
        </div>

        @if (Model != null)
        {
            <div class="card border-0 bg-light text-start mb-4">
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5">Viitenumero</dt>
                        <dd class="col-7 font-monospace">
                            @Model.Id.ToString()[..8].ToUpper()
                        </dd>
                        <dt class="col-5">Lähetetty</dt>
                        <dd class="col-7">@Model.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt class="col-5">Lähettäjä</dt>
                        <dd class="col-7">
                            @(Model.IsAnonymous ? "Nimetön" : Model.SuomiFiName)
                        </dd>
                    </dl>
                </div>
            </div>
        }

        <p class="text-muted small mb-3">
            <i class="bi bi-arrow-return-left me-1"></i>
            Sinut ohjataan takaisin etusivulle <span id="countdown">@redirectSeconds</span> sekunnin kuluttua.
        </p>

        <a href="/@tenantSlug/forms" class="btn btn-primary me-2">
            <i class="bi bi-arrow-left me-1"></i>Takaisin lomakkeisiin
        </a>
        <a href="/@tenantSlug/admin" class="btn btn-outline-secondary">
            <i class="bi bi-inbox me-1"></i>Näytä postilaatikko
        </a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let seconds = @redirectSeconds;
            const el = document.getElementById('countdown');
            const returnUrl = '/@tenantSlug/forms';
            const timer = setInterval(() => {
                seconds--;
                if (el) el.textContent = seconds;
                if (seconds <= 0) {
                    clearInterval(timer);
                    window.location.href = returnUrl;
                }
            }, 1000);
        })();
    </script>
}